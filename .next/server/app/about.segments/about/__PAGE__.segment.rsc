xt-lg leading-9 text-slate-300","children":"LifeSignal was built for that real-world middle ground. It is designed for seniors, families, caregivers, recovery support environments, and connected communities that want something more dependable than casual texting and less invasive than constant tracking."}]]}],["$","div",null,{"className":"rounded-3xl border border-white/10 bg-white/5 p-8","children":[["$","p",null,{"className":"text-base font-semibold uppercase tracking-[0.24em] text-sky-300","children":"Mission"}],["$","p",null,{"className":"mt-4 text-lg leading-9 text-slate-200","children":"Our mission is to help people live with more independence and more dignity, while giving families and support networks a clearer way to know when everything is okay and when something may need attention."}],["$","p",null,{"className":"mt-4 text-lg leading-9 text-slate-200","children":"LifeSignal is intentionally human-centered. It is not about replacing relationships. It is about making those relationships easier to support with consistency and clarity."}]]}]]}]}],["$","section",null,{"className":"border-b border-white/10","children":["$","div",null,{"className":"mx-auto max-w-7xl px-6 py-16 md:px-8 md:py-20","children":[["$","div",null,{"className":"mb-10 max-w-2xl","children":[["$","p",null,{"className":"text-base font-semibold uppercase tracking-[0.24em] text-sky-300","children":"Core philosophy"}],["$","h2",null,{"className":"mt-3 text-3xl font-semibold tracking-tight text-white md:text-4xl","children":"Three principles shape the product."}]]}],["$","div",null,{"className":"grid gap-6 md:grid-cols-3","children":[["$","div","Simplicity",{"className":"rounded-3xl border border-white/10 bg-white/5 p-6","children":[["$","h3",null,{"className":"text-xl font-semibold text-white","children":"Simplicity"}],"$L2"]}],"$L3","$L4"]}]]}]}],"$L5"]}],null,"$L6"]}],"loading":null,"isPartial":false}
