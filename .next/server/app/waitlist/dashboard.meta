{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/waitlist/layout,_N_T_/waitlist/dashboard/layout,_N_T_/waitlist/dashboard/page,_N_T_/waitlist/dashboard"
  },
  "segmentPaths": [
